# ─── API Server (.env in artifacts/api-server/) ───────────────────────────────
# Copy this block to artifacts/api-server/.env

PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/pdfexpert
SESSION_SECRET=change-me-to-a-random-64-char-string
NODE_ENV=development

# ─── Frontend (.env in artifacts/pdf-expert/) ─────────────────────────────────
# Copy this block to artifacts/pdf-expert/.env

PORT=3000
BASE_PATH=/
# Only set VITE_API_URL when the API is on a different host (e.g. Railway)
# VITE_API_URL=https://your-api.railway.app
